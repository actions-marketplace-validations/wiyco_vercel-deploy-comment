{
  "name": "vercel-deploy-comment",
  "version": "3.0.0",
  "description": "A GitHub Action that deploys Vercel projects and environments and keeps a pull request comment updated.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "action.yml",
    "docs",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "TERMS.md"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b && rolldown -c rolldown.config.ts",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:smoke:watch": "vitest --config vitest.smoke.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check . --error-on-warnings --write",
    "all": "pnpm run check && pnpm test && pnpm run build"
  },
  "keywords": [
    "github-action",
    "vercel",
    "pull-request",
    "preview-deployment"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "lefthook": "^2.2.2",
    "rolldown": "1.2.14",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
